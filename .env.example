# Copy to .env and fill in. Never commit real secrets: .env is git-ignored.

# MongoDB (replica set). Default: local one started by `npm run db:start`
MONGODB_URI="mongodb://127.0.0.1:27017/todo?replicaSet=rs0"

# GitHub OAuth App — create one at https://github.com/settings/developers (see docs/LOGIN.md)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
# Optional. Defaults to <app origin>/auth/github/callback; must match the OAuth App's callback URL
GITHUB_CALLBACK_URL=""
